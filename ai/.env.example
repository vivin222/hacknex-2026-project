# Environment Configuration for Team CRY NOVA
# Extreme Bad-Handwriting Digitizing Stack (HNX26EPS04)

# Google Gemini API Key for VLM Visual Reasoning & LLM Post-Correction
# Get a key from https://aistudio.google.com/
GEMINI_API_KEY=

# Pipeline Configuration Defaults
DEFAULT_VLM_MODEL=gemini-2.5-flash
DEFAULT_LLM_MODEL=gemini-2.5-flash
ENABLE_PREPROCESSING=true
ENABLE_VLM=true
ENABLE_LLM_CORRECTION=true
ENABLE_UNCERTAINTY=true
DEBUG_MODE=false
